# Rename this file to .env only if you use an environment loader, or set these variables in your host.
PORT=3000
# Protect dashboard API endpoints in production. Website lead submission stays public.
ASTRAFLOW_API_KEY=replace-with-a-long-random-secret
# Optional: n8n Production webhook URL. Every new lead is posted here as { event: "new_lead", lead: {...} }.
N8N_WEBHOOK_URL=https://your-n8n-domain/webhook/new-lead
# Optional: Slack Incoming Webhook URL for lead notifications.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook
